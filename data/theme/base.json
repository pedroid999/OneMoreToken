{
  "version": 1,
  "font": {
    "mono": [
      "FiraCode Nerd Font",
      "Fira Code",
      "JetBrains Mono",
      "ui-monospace",
      "SFMono-Regular",
      "Menlo",
      "monospace"
    ],
    "sans": ["Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"]
  },
  "fontSize": {
    "xs": "0.75rem",
    "sm": "0.8125rem",
    "md": "0.875rem",
    "lg": "1rem",
    "xl": "1.25rem",
    "xxl": "1.75rem"
  },
  "fontWeight": {
    "regular": 400,
    "medium": 500,
    "bold": 700
  },
  "lineHeight": {
    "tight": 1.2,
    "normal": 1.5
  },
  "density": {
    "comfortable": {
      "spaceUnit": "4px"
    },
    "compact": {
      "spaceUnit": "3px"
    }
  },
  "space": {
    "0": 0,
    "1": 1,
    "2": 2,
    "3": 3,
    "4": 4,
    "5": 6,
    "6": 8,
    "7": 12,
    "8": 16
  },
  "radius": {
    "none": "0",
    "sm": "2px",
    "md": "4px"
  },
  "borderWidth": {
    "thin": "1px",
    "focus": "2px"
  },
  "layout": {
    "statusBarHeight": "1.75rem",
    "sidebarWidth": "14rem",
    "contentMaxWidth": "96rem",
    "controlHeight": "1.875rem"
  },
  "motion": {
    "durationFast": "100ms",
    "durationBase": "160ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  }
}
